# =======================================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (Xiorizos)
# =======================================================================
# Coloca aquí tu URL de conexión de PostgreSQL.
#
# Opciones recomendadas:
# 1. Supabase (Nube gratis):
#    DATABASE_URL="postgresql://postgres.[TU_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# 2. Neon (Nube gratis):
#    DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/xiorizos?sslmode=require"
#
# 3. PostgreSQL Local en tu PC:
#    DATABASE_URL="postgresql://postgres:password@localhost:5432/xiorizos?schema=public"
# =======================================================================

DATABASE_URL="postgresql://postgres:password@localhost:5432/xiorizos?schema=public"

